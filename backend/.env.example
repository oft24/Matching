PORT=4000
PYTHON_SERVICE_URL=http://localhost:8001
APP_URL=http://localhost:5173

# PostgreSQL — recomendado: Neon (https://neon.tech) plan gratis
# Ejemplo: postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@POOLER:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@POOLER:5432/postgres?sslmode=require"

JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"

# Inicio de sesión con Google. Client ID de un cliente OAuth de tipo
# "Aplicación web" en https://console.cloud.google.com/apis/credentials
# Es público (viaja al navegador); NO hace falta el client secret.
GOOGLE_CLIENT_ID=""
# Actívalo sólo después de autorizar el origen web de q2play en Google Cloud.
GOOGLE_AUTH_ENABLED="false"

# Riot Developer Portal: https://developer.riotgames.com/
# La app funciona sin esta clave; sólo se desactiva la verificación y el dashboard Riot.
RIOT_API_KEY=""

# Opcional: salas privadas de Discord al confirmar match. El bot necesita
# Manage Channels + Create Invite; OAuth usa identify + guilds.join.
# DISCORD_BOT_TOKEN=""
# DISCORD_GUILD_ID=""
# DISCORD_CATEGORY_ID=""
# DISCORD_CHANNEL_TTL_HOURS="12"
# DISCORD_CLIENT_ID=""
# OAuth usa PKCE: habilita Public Client en Discord; no se guarda client secret.
# DISCORD_REDIRECT_URI="http://localhost:4000/api/connections/discord/callback"
