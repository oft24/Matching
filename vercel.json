{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "src/app.js",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "scoring",
          "format": "url",
          "env": "PYTHON_SERVICE_URL"
        }
      ]
    },
    "scoring": {
      "root": "services/python/",
      "entrypoint": "app.main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
