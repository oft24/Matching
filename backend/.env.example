PORT=4000
PYTHON_SERVICE_URL=http://localhost:8001

# PostgreSQL — recomendado: Neon (https://neon.tech) plan gratis
# Ejemplo: postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@POOLER:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@POOLER:5432/postgres?sslmode=require"

JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"

# Correo de verificación. Se usa Brevo si hay BREVO_API_KEY; si no, Resend.
# Sin ninguna de las dos, el código se imprime en la consola del backend.

# Brevo (https://brevo.com) — 300 correos/día gratis. Permite verificar UNA
# dirección de remitente sin poseer un dominio, que es lo que lo hace viable
# sin comprar nada. La clave se saca en SMTP & API → API Keys.
BREVO_API_KEY=""

# Resend (https://resend.com) — mejor entregabilidad, pero exige verificar un
# dominio propio para escribir a destinatarios que no seas tú.
RESEND_API_KEY=""

# Debe coincidir EXACTAMENTE con el remitente verificado del proveedor activo.
MAIL_FROM="Matching <tu-correo-verificado@gmail.com>"

# Opcional: invitaciones Discord automáticas al confirmar match
# DISCORD_BOT_TOKEN=""
# DISCORD_GUILD_ID=""
