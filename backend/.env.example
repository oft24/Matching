PORT=4000
PYTHON_SERVICE_URL=http://localhost:8001

# PostgreSQL — recomendado: Neon (https://neon.tech) plan gratis
# Ejemplo: postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@POOLER:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@POOLER:5432/postgres?sslmode=require"

JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"

# Inicio de sesión con Google. Client ID de un cliente OAuth de tipo
# "Aplicación web" en https://console.cloud.google.com/apis/credentials
# Es público (viaja al navegador); NO hace falta el client secret.
GOOGLE_CLIENT_ID=""

# Opcional: invitaciones Discord automáticas al confirmar match
# DISCORD_BOT_TOKEN=""
# DISCORD_GUILD_ID=""
